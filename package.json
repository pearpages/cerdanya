{
  "name": "cerdanya",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Guia gastronòmica de la Cerdanya",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/lint-credits.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro build && node scripts/check-build.mjs",
    "data:villages": "node scripts/build-villages.mjs",
    "data:valley": "node scripts/build-valley-profile.mjs",
    "data:locations": "node scripts/build-locations.mjs",
    "data:locations:apply": "node scripts/apply-locations.mjs",
    "data:maps": "node scripts/render-maps.mjs",
    "data:icons": "node scripts/render-icons.mjs",
    "data:images": "node scripts/fetch-images.mjs",
    "data:images:apply": "node scripts/apply-image-credits.mjs",
    "data:credits": "node scripts/lint-credits.mjs",
    "data:collect": "node scripts/fetch-images.mjs --collect",
    "data:publish": "node scripts/publish-images.mjs",
    "data:restore": "node scripts/restore-images.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@pearpages/credit": "^0.2.0",
    "astro": "^7.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
