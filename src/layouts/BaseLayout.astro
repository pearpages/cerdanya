---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

import '@fontsource-variable/archivo';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/azeret-mono';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** Imatge social absoluta o relativa a l'arrel del lloc. */
  ogImage?: string;
  /** Amaga el separador superior del peu quan la pàgina ja acaba amb una banda fosca. */
  flushFooter?: boolean;
  /** Dades estructurades (JSON-LD). Els constructors són a lib/structured-data.ts. */
  jsonLd?: object | object[];
}

const { title, description, ogImage, flushFooter = false, jsonLd } = Astro.props;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const SITE_NAME = 'Cota de tast';
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = ogImage ? new URL(ogImage, Astro.site) : undefined;
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      L'ordre de les capes s'ha de fixar abans que cap altre CSS. Astro pot inlinear el
      full d'un component —que obre @layer components— per damunt del bundle que porta
      base.css, i llavors «components» queda registrat primer i el reset, declarat després,
      el trepitja: els marges dels components desapareixen. Amb l'ordre declarat aquí, la
      resta de fulls només hi afegeixen regles.
    */}
    <style is:inline>@layer reset, tokens, base, components, utilities;</style>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* El senyal de la capçalera. L'.ico va primer per als navegadors sense SVG. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ca_ES" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />

    {/*
      JSON-LD. Va amb set:html i no interpolat com a text: el contingut és JSON i
      Astro escaparia les cometes, cosa que el faria illegible per als cercadors.
      JSON.stringify ja no pot produir cap </script> perquè cap valor no en porta,
      però es tanca igualment la barra per si un dia un camp lliure sí que en porta.
    */}
    {schemas.map((schema) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
      />
    ))}

    <meta name="theme-color" content="#f4f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#061420" media="(prefers-color-scheme: dark)" />

    {/* Aplica el tema desat abans del primer pintat per evitar el flaix. */}
    <script is:inline>
      (() => {
        const saved = () => {
          try {
            const value = localStorage.getItem('cerdanya-theme');
            return value === 'light' || value === 'dark' ? value : null;
          } catch {
            /* localStorage bloquejat: es manté la preferència del sistema */
            return null;
          }
        };

        const apply = (root) => {
          const value = saved();
          if (value) root.dataset.theme = value;
          else delete root.dataset.theme;
        };

        apply(document.documentElement);

        /*
          El ClientRouter copia els atributs de <html> del document nou, que és
          HTML estàtic i no en porta cap: sense això, data-theme desapareixeria a
          cada navegació interna i la pàgina tornaria al tema del sistema. Aquest
          script no es torna a executar (Astro conserva els scripts del <head>),
          així que el tema es reposa al document nou abans del canvi, no després,
          perquè no s'arribi a pintar amb el tema equivocat.
        */
        document.addEventListener('astro:before-swap', (event) => {
          apply(event.newDocument.documentElement);
        });
      })();
    </script>

    <ClientRouter />
    <script defer src="https://analytics.pearpages.com/script.js" data-website-id="86cb5b6f-b274-4d87-bfef-a08353c3a976"></script>
  </head>
  <body>
    <a class="skip-link" href="#contingut">Vés al contingut</a>
    <SiteHeader />
    <main id="contingut">
      <slot />
    </main>
    <SiteFooter flush={flushFooter} />
  </body>
</html>
