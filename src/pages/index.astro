---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import RestaurantCard from '../components/RestaurantCard.astro';
import ValleySection from '../components/ValleySection.astro';
import {
  allRestaurants,
  featured,
  formatElevation,
  groupByCuisine,
  groupByVillage,
  valleyVillages,
} from '../lib/restaurants';
import { siteImage } from '../lib/site-images';
import valleyData from '../data/valley-profile.json';
import '../styles/home.css';

const restaurants = await allRestaurants();
const villages = groupByVillage(restaurants);
const valley = valleyVillages(restaurants);
const cuisines = groupByCuisine(restaurants);

/** Una destacada gran i set més: omple dues files senceres a l'amplada màxima. */
const picks = featured(restaurants).slice(0, 7);

const lowest = villages[0];
const highest = villages.at(-1)!;
const drop = highest.elevation - lowest.elevation;

const photoCount = restaurants.reduce((sum, entry) => sum + entry.data.images.length, 0);
const thinCount = restaurants.filter((entry) => entry.data.dataThin).length;
const frenchCount = restaurants.filter((entry) => entry.data.country === 'FR').length;

const hero = siteImage('portada');
const trinxat = siteImage('trinxat');

/** Retall social de la portada. JPEG i no WebP: encara hi ha rastrejadors que no el llegeixen. */
const social = await getImage({
  src: hero.src,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});

const stats = [
  { value: String(restaurants.length), label: 'restaurants' },
  { value: String(villages.length), label: 'pobles' },
  {
    value: `${formatElevation(lowest.elevation)}–${formatElevation(highest.elevation)}`,
    label: 'metres de cota',
  },
  { value: String(valleyData.meta.lengthKm).replace('.', ','), label: 'km de vall' },
];
---

<BaseLayout
  title="Cota de tast"
  description={`Guia dels ${restaurants.length} restaurants de la Cerdanya, dels dos costats de la frontera, ordenada per altitud: de ${lowest.name} a ${formatElevation(lowest.elevation)} m fins a ${highest.name} a ${formatElevation(highest.elevation)} m.`}
  ogImage={social.src}
  flushFooter
>
  <section class="home-hero">
    <div class="home-hero__media">
      <Image
        class="home-hero__image"
        src={hero.src}
        alt={hero.alt}
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <PhotoCredit
        author={hero.author}
        license={hero.license}
        licenseUrl={hero.licenseUrl}
        sourceUrl={hero.sourceUrl}
        isOfficial={hero.isOfficial}
        tone="over"
      />
    </div>

    <div class="home-hero__text page">
      <p class="eyebrow home-hero__eyebrow">Guia de restaurants de la Cerdanya</p>
      <h1 class="home-hero__title">Es menja per cotes</h1>
      <p class="home-hero__lead">
        Els {restaurants.length} restaurants de la vall ordenats per altitud i no per nota: dels {
          formatElevation(lowest.elevation)
        } m de {lowest.name} als {formatElevation(highest.elevation)} m de {highest.name}, amb la frontera
        pel mig i sense fer-ne cas.
      </p>
      <p class="home-hero__actions">
        <a class="home-action home-action--solid" href="/restaurants/">Tots els restaurants</a>
        <a class="home-action" href="/pobles/">Poble per poble</a>
      </p>
    </div>
  </section>

  <ul class="home-stats page">
    {
      stats.map((stat) => (
        <li class="home-stats__item">
          <span class="home-stats__value mono">{stat.value}</span>
          <span class="home-stats__label">{stat.label}</span>
        </li>
      ))
    }
  </ul>

  <section class="home-section page" aria-labelledby="home-tall">
    <header class="home-section__head">
      <p class="eyebrow">El tall</p>
      <h2 class="home-section__title" id="home-tall">Tota la vall, de perfil</h2>
      <p class="home-section__lead">
        Entre {lowest.name} i {highest.name} hi ha {formatElevation(drop)} metres de desnivell, i és
        això el que ordena la guia. Cada punt és un poble amb restaurants a dins; com més gran, més
        en té. La ratlla vertical és la frontera, que aquí passa pel mig de l’altiplà: {frenchCount}
        {frenchCount === 1 ? ' fitxa és' : ' fitxes són'} del costat francès.
      </p>
    </header>

    <ValleySection villages={valley} headingId="home-tall" />
  </section>

  <section class="home-section page" aria-labelledby="home-picks">
    <header class="home-section__head">
      <p class="eyebrow">Per on començar</p>
      <h2 class="home-section__title" id="home-picks">Una tria per situar-se</h2>
      <p class="home-section__lead">
        {picks.length} cases que expliquen bé com es menja a cada cota: cuina de mercat i producte de la
        vall a baix, taula francesa al replà de Font-Romeu, i pel mig Llívia, que és Espanya voltada
        de França.
      </p>
    </header>

    <div class="home-picks">
      {
        picks.map((entry, index) => (
          <RestaurantCard entry={entry} featured={index === 0} loading={index < 3 ? 'eager' : 'lazy'} />
        ))
      }
    </div>

    <p class="home-more">
      <a href="/restaurants/">Veure els {restaurants.length} restaurants, amb filtres</a>
    </p>
  </section>

  <section class="home-section page" aria-labelledby="home-cuina">
    <header class="home-section__head">
      <p class="eyebrow">Per cuina</p>
      <h2 class="home-section__title" id="home-cuina">Què s’hi cuina</h2>
      <p class="home-section__lead">
        {cuisines.length} categories, i moltes cases en porten més d’una: a la Cerdanya una casa de
        brasa pot fer arrossos i una cuina de mercat treu trinxat quan toca.
      </p>
    </header>

    <ul class="home-cuisines">
      {
        cuisines.map((cuisine) => (
          <li>
            <a class="home-cuisine" href={`/cuina/${cuisine.slug}/`}>
              <span class="home-cuisine__name">{cuisine.name}</span>
              <span class="home-cuisine__count mono">{cuisine.restaurants.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-method" aria-labelledby="home-method">
    <div class="home-method__inner page">
      <div class="home-method__text">
        <p class="eyebrow home-method__eyebrow">Com està feta</p>
        <h2 class="home-method__title" id="home-method">Escrita a mà, amb les fonts a la vista</h2>
        <p>
          Cada fitxa està redactada de nou a partir de fonts públiques que es citen al peu: el web
          del restaurant, la carta que publica, la fitxa de l’oficina de turisme. Quan d’una casa no
          en circula res de comprovable, ho diem i la fitxa es queda curta — {thinCount} de les {
            restaurants.length
          } porten aquesta marca.
        </p>
        <p>
          Les {photoCount} fotografies són dels seus autors, amb llicència i enllaç a l’original una
          per una. No és una promesa: el build s’atura si a alguna imatge li falta l’autor, la
          llicència o l’origen.
        </p>
        <p class="home-method__links">
          <a href="/credits/">Crèdits fotogràfics i dades</a>
        </p>
      </div>

      <figure class="home-method__figure">
        <Image
          class="home-method__image"
          src={trinxat.src}
          alt={trinxat.alt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 52rem) 92vw, 26rem"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="home-method__caption">
          <PhotoCredit
            author={trinxat.author}
            license={trinxat.license}
            licenseUrl={trinxat.licenseUrl}
            sourceUrl={trinxat.sourceUrl}
            isOfficial={trinxat.isOfficial}
          />
        </figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>
