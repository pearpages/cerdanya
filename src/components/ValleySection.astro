---
/**
 * El tall — secció longitudinal de la Cerdanya amb els pobles a la seva cota.
 *
 * No és una il·lustració. El relleu és el perfil real del fons de vall mostrejat cada
 * 250 m sobre el model digital del terreny (vegeu scripts/build-valley-profile.mjs), i
 * cada poble hi seu a la seva altitud mesurada. La frontera hi surt on és de debò,
 * al km 23, perquè aquesta vall en té una al mig i això explica què s'hi menja.
 */
import valleyData from '../data/valley-profile.json';
import { toSlug } from '../data/taxonomy';
import './ValleySection.css';

export interface ValleyVillage {
  name: string;
  elevation: number;
  count: number;
  subregion: string;
}

interface Props {
  villages: ValleyVillage[];
  /** Poble que es marca com a actual, a les fitxes de restaurant. */
  highlight?: string;
  compact?: boolean;
  headingId?: string;
}

const { villages, highlight, compact = false, headingId } = Astro.props;

const W = 1000;
const H = compact ? 190 : 330;
const PAD = { top: compact ? 14 : 30, right: 18, bottom: compact ? 22 : 34, left: 48 };

const ELE_MIN = 900;
const ELE_MAX = 1850;
const LENGTH_KM = valleyData.meta.lengthKm;

const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const x = (km: number) => PAD.left + (km / LENGTH_KM) * plotW;
const y = (ele: number) => PAD.top + (1 - (ele - ELE_MIN) / (ELE_MAX - ELE_MIN)) * plotH;

/**
 * Relleu: la línia del terreny, tancada per sota per poder-la omplir.
 * Les cotes es suavitzen amb una mitjana de tres mostres. El congost del Segre fa
 * pics de desenes de metres entre mostres consecutives i, dibuixats en cru, es
 * llegeixen com a soroll; la forma de la vall es manté igual.
 */
const raw = valleyData.profile;
const smoothed = raw.map((p, i) => {
  const window = [raw[i - 1], p, raw[i + 1]].filter(Boolean);
  return { km: p.km, ele: window.reduce((sum, s) => sum + s.ele, 0) / window.length };
});
const ridge = smoothed.map((p) => `${x(p.km).toFixed(1)},${y(p.ele).toFixed(1)}`);
const terrainFill = `M ${PAD.left},${H - PAD.bottom} L ${ridge.join(' L ')} L ${W - PAD.right},${H - PAD.bottom} Z`;
const terrainLine = `M ${ridge.join(' L ')}`;

const contours = [1000, 1200, 1400, 1600, 1800];

/** Cota del terreny sota un punt, per dibuixar la tija que hi baixa. */
function groundAt(km: number): number {
  let closest = valleyData.profile[0];
  for (const p of valleyData.profile) {
    if (Math.abs(p.km - km) < Math.abs(closest.km - km)) closest = p;
  }
  return closest.ele;
}

const placed = valleyData.villages as Array<{
  name: string;
  elevation: number;
  km: number;
  offsetKm: number;
  subregion: string;
}>;

const pins = villages
  .map((v) => {
    const geo = placed.find((p) => p.name === v.name);
    if (!geo) return null;
    const ground = groundAt(geo.km);
    return {
      ...v,
      km: geo.km,
      /** Més de 2 km fora de l'eix vol dir que el poble és de vessant, no de fons de vall. */
      onSlope: geo.offsetKm > 2,
      cx: x(geo.km),
      cy: y(v.elevation),
      groundY: y(Math.min(ground, v.elevation)),
      slug: toSlug(v.name),
      isHighlight: v.name === highlight,
    };
  })
  .filter((p): p is NonNullable<typeof p> => p !== null)
  .sort((a, b) => a.km - b.km);

const maxCount = Math.max(1, ...pins.map((p) => p.count));
const radius = (count: number) => 3.1 + Math.sqrt(count / maxCount) * 4.4;

/**
 * Amb prop de quaranta pobles no hi caben tots els noms. Es reserven per als que
 * tenen més d'un restaurant —que és informació, no una tria estètica— i per al poble
 * de la fitxa que s'estigui mirant. La resta responen en passar-hi per sobre.
 */
const CHAR_W = 5.6;
const ROW_OFFSETS = [13, 26, 39];

const labelled = (compact ? pins.filter((p) => p.isHighlight) : pins.filter((p) => p.count > 1 || p.isHighlight))
  .map((pin) => {
    const width = pin.name.length * CHAR_W;
    // A prop de les vores, el nom s'ancora cap endins per no sortir del dibuix.
    const anchor =
      pin.cx - width / 2 < PAD.left ? 'start' : pin.cx + width / 2 > W - PAD.right ? 'end' : 'middle';
    const left = anchor === 'start' ? pin.cx : anchor === 'end' ? pin.cx - width : pin.cx - width / 2;
    return { ...pin, width, anchor, left, right: left + width, labelY: pin.cy - ROW_OFFSETS[0] };
  })
  .sort((a, b) => a.left - b.left);

/**
 * Reparteix els noms en fileres. Cal comparar la posició absoluta i no el número de
 * filera: dos pobles a cotes diferents poden acabar a la mateixa alçada del dibuix
 * encara que estiguin en fileres distintes.
 */
const LABEL_GAP_X = 7;
const LABEL_GAP_Y = 11.5;

for (const [index, label] of labelled.entries()) {
  const earlier = labelled.slice(0, index);
  const collides = (candidateY: number) =>
    earlier.some(
      (other) =>
        other.right + LABEL_GAP_X > label.left &&
        other.left - LABEL_GAP_X < label.right &&
        Math.abs(other.labelY - candidateY) < LABEL_GAP_Y,
    );

  const free = ROW_OFFSETS.map((offset) => label.cy - offset).find((candidate) => !collides(candidate));
  label.labelY = free ?? label.cy - ROW_OFFSETS.at(-1)!;
}

/** La ratlla: Bourg-Madame / Puigcerdà, on la frontera creua l'altiplà. */
const BORDER_KM = 23;
const borderX = x(BORDER_KM);
---

<figure class:list={['valley', compact && 'valley--compact']}>
  <div class="valley__scroll">
    <svg
      class="valley__svg"
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-labelledby={headingId}
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <linearGradient id="valley-terrain" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" class="valley__grad-top"></stop>
          <stop offset="100%" class="valley__grad-bottom"></stop>
        </linearGradient>
      </defs>

      {/* Corbes de nivell */}
      <g class="valley__contours" aria-hidden="true">
        {
          contours.map((ele) => (
            <>
              <line x1={PAD.left} y1={y(ele)} x2={W - PAD.right} y2={y(ele)} />
              <text class="valley__contour-label" x={PAD.left - 9} y={y(ele) + 3.4}>
                {ele}
              </text>
            </>
          ))
        }
        <text class="valley__axis-unit" x={PAD.left - 9} y={PAD.top - 10}>m</text>
      </g>

      {/* Relleu real del fons de vall */}
      <path class="valley__terrain" d={terrainFill} aria-hidden="true"></path>
      <path class="valley__ridge" d={terrainLine} aria-hidden="true"></path>

      {/* La frontera */}
      <g class="valley__border" aria-hidden="true">
        <line x1={borderX} y1={PAD.top - 4} x2={borderX} y2={H - PAD.bottom}></line>
        <text class="valley__border-label" x={borderX - 7} y={PAD.top + 7} text-anchor="end">
          Espanya
        </text>
        <text class="valley__border-label" x={borderX + 7} y={PAD.top + 7}>França</text>
      </g>

      {/* Pobles */}
      <g class="valley__pins">
        {
          pins.map((pin) => (
            <a
              class:list={[
                'valley__pin',
                pin.isHighlight && 'valley__pin--current',
                pin.onSlope && 'valley__pin--slope',
              ]}
              href={`/pobles/${pin.slug}/`}
            >
              <title>
                {pin.name} · {pin.elevation} m ·{' '}
                {pin.count === 1 ? '1 restaurant' : `${pin.count} restaurants`}
              </title>
              <line
                class="valley__stem"
                x1={pin.cx}
                y1={pin.cy}
                x2={pin.cx}
                y2={pin.groundY}
              />
              <circle class="valley__dot" cx={pin.cx} cy={pin.cy} r={radius(pin.count)} />
              <circle class="valley__hit" cx={pin.cx} cy={pin.cy} r="14" />
            </a>
          ))
        }
      </g>

      {/* Noms, a sobre de tot i repartits en files per no trepitjar-se */}
      <g class="valley__labels" aria-hidden="true">
        {
          labelled.map((pin) => (
            <text
              class:list={['valley__label', pin.isHighlight && 'valley__label--current']}
              x={pin.cx}
              y={pin.labelY}
              text-anchor={pin.anchor}
            >
              {pin.name}
            </text>
          ))
        }
      </g>

      {/* Escala horitzontal */}
      <g class="valley__axis" aria-hidden="true">
        <text class="valley__axis-unit" x={W / 2} y={H - 8} text-anchor="middle">
          {String(LENGTH_KM).replace('.', ',')} km de vall, de Martinet a Font-Romeu
        </text>
      </g>
    </svg>
  </div>

  {
    !compact && (
      <figcaption class="valley__caption">
        Perfil del fons de vall mostrejat cada 250 m sobre el model digital del terreny
        (EU-DEM 25 m) i suavitzat lleugerament perquè es llegeixi. Cada punt és un poble amb
        restaurants a la guia, a la seva altitud real; com més gran, més en té. Els punts
        buits són pobles de vessant, enfilats fora de l’eix de la vall.
      </figcaption>
    )
  }
</figure>
